{
  "name": "ai-qa-framework",
  "version": "2.11.9",
  "type": "module",
  "description": "Universal AI QA Automation Framework — project-agnostic, enterprise-grade. Install with npx ai-qa-framework install.",
  "license": "MIT",
  "author": "Ahmed Al Wakeel <afmelwekeel@github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afmelwekeel/AI-QA-Framework.git"
  },
  "homepage": "https://github.com/afmelwekeel/AI-QA-Framework#readme",
  "bugs": {
    "url": "https://github.com/afmelwekeel/AI-QA-Framework/issues"
  },
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "ai",
    "automation",
    "cli",
    "npx",
    "test-generation",
    "bmad",
    "e2e",
    "accessibility",
    "security"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "ai-qa-framework": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "core/orchestrator.mjs",
    "core/autonomous-loop.mjs",
    "core/ARCHITECTURE.md",
    "agents/",
    "skills/",
    "workflows/",
    "templates/",
    "rules/",
    "adapters/",
    "project-detectors/",
    "reusable-prompts/",
    "commands/registry.yaml",
    "_config/",
    "_memory/",
    "config.yaml",
    "playwright.config.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "qa": "node ./core/orchestrator.mjs",
    "detect": "node ./core/orchestrator.mjs detect",
    "analyze-story": "node ./core/orchestrator.mjs analyze-story",
    "test-cases": "node ./core/orchestrator.mjs generate-test-cases",
    "e2e": "node ./core/orchestrator.mjs generate-e2e",
    "test-data": "node ./core/orchestrator.mjs generate-test-data",
    "run-tests": "playwright test --headed",
    "run-tests:ci": "playwright test",
    "run-tests:debug": "playwright test --debug",
    "bugs": "node ./core/orchestrator.mjs analyze-bugs",
    "report": "node ./core/orchestrator.mjs generate-report",
    "full": "node ./core/orchestrator.mjs full-workflow",
    "show-report": "playwright show-report ./reports/playwright-html",
    "fetch-test-users": "node ./core/orchestrator.mjs fetch-test-users"
  },
  "dependencies": {
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@axe-core/playwright": "^4.9.1"
  }
}

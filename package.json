{
  "name": "ai-qa-framework",
  "version": "3.5.1",
  "type": "module",
  "description": "Universal AI QA Automation Framework — project-agnostic, enterprise-grade. Install with npx ai-qa-framework install.",
  "license": "MIT",
  "author": "Ahmed Al Wakeel <afmelwekeel@github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afmelwekeel/AI-QA-Framework.git"
  },
  "homepage": "https://github.com/afmelwekeel/AI-QA-Framework#readme",
  "bugs": {
    "url": "https://github.com/afmelwekeel/AI-QA-Framework/issues"
  },
  "keywords": [
    "qa",
    "testing",
    "playwright",
    "ai",
    "automation",
    "cli",
    "npx",
    "test-cases",
    "bmad",
    "playwright-mcp",
    "bug-reports"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "ai-qa-framework": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "core/orchestrator.mjs",
    "core/autonomous-loop.mjs",
    "core/ARCHITECTURE.md",
    "core/compress-prompts.mjs",
    "core/token-stats.mjs",
    "agents/",
    "skills/",
    "hooks/",
    "workflows/",
    "templates/",
    "rules/",
    "adapters/",
    "project-detectors/",
    "reusable-prompts/",
    "commands/registry.yaml",
    "_config/",
    "_memory/",
    "config.yaml",
    "CLAUDE.md",
    "playwright.config.js",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "qa": "node ./core/orchestrator.mjs",
    "detect": "node ./core/orchestrator.mjs detect"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0"
  }
}
